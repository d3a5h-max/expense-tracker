{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Expense Tracker",
  "version": "1.0.0",
  "identifier": "com.expensetracker.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": null
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Expense Tracker",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false,
        "decorations": false,
        "transparent": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": []
  }
}